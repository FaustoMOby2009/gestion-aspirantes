                  <TextField fx:id="txtEmail" layoutX="185.0" layoutY="173.0" prefHeight="25.0" prefWidth="189.0" />
                  <ComboBox fx:id="cmbRoles" layoutX="184.0" layoutY="273.0" prefHeight="25.0" prefWidth="189.0" />
